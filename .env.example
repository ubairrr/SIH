# CaseVault environment variables. Copy to .env and fill in real values —
# .env is gitignored and never committed. See .planning/phases/01-.../01-RESEARCH.md
# Code Examples §1 for the hosted-vs-offline split this is derived from.

# --- Database (required, both hosted and offline modes) ---
# Hosted (Vercel + Supabase): pooled connection (port 6543, pgbouncer=true)
# for the running app, direct connection (port 5432) for migrations only.
# Copy the exact strings from that Supabase project's dashboard
# (Database -> Connection string) — do not hand-type based on this template.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Offline (Docker Postgres + local disk) — same two variables, pointed at
# the local docker-compose Postgres instance instead:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/casevault"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/casevault"

# --- Session (required) ---
# Generate with: openssl rand -base64 32
SESSION_SECRET="<32-byte base64 secret>"

# --- Demo mode (optional) ---
# When "true", the login page shows a "Demo accounts" panel (D-17).
DEMO_MODE="true"

# --- Storage (Plan 01-04 extends this file with STORAGE_DRIVER / SUPABASE_* /
# LOCAL_STORAGE_PATH once the StorageAdapter interface is wired up) ---
