# CaseVault offline-mode environment variables. Copy to .env.local and fill
# in SESSION_SECRET — .env.local is gitignored and never committed. Used by
# `npm run dev:offline` (docker-compose Postgres + local-disk storage). See
# .planning/phases/01-login-user-management-tamper-proof-audit-log/01-RESEARCH.md
# Code Examples §1.

# --- Database (offline: local docker-compose Postgres, no pooler exists locally) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/casevault"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/casevault"

# --- Storage (offline: local disk) ---
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./.data/storage"

# --- Session (required) ---
# Generate with: openssl rand -base64 32
SESSION_SECRET="<32-byte base64 secret>"

# --- Demo mode ---
# When "true", the login page shows a "Demo accounts" panel (D-17).
DEMO_MODE="true"
