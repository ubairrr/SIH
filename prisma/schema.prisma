// CaseVault Prisma schema — Phase 1 (Login, User Management & Tamper-Proof Audit Log)
// See .planning/phases/01-login-user-management-tamper-proof-audit-log/01-RESEARCH.md
// Pattern 3 for the pooled/direct URL split, and Pattern 2 for the AuditLog
// append-only enforcement (applied via hand-edited migration SQL, not here).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled, port 6543, ?pgbouncer=true
  directUrl = env("DIRECT_URL") // unpooled, port 5432 — migrations only
}

enum Role {
  POLICE
  FORENSICS
  PROSECUTION
  COURT
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  username     String   @unique
  role         Role
  designation  String
  unit         String
  badgeId      String
  isActive     Boolean  @default(true)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogEntries  AuditLog[]
  registeredCases  Case[]
  stageMoves       StageHistory[]
  documents        Document[]
  documentVersions DocumentVersion[]
}

// D-06 stage order: FIR_REGISTERED -> UNDER_INVESTIGATION -> CHARGE_SHEET_FILED
// -> IN_COURT -> CLOSED_JUDGMENT. Stages are indicators of real-world case
// progress, not access gates (02-CONTEXT.md Model Change) — every department
// can view/edit any open case regardless of stage.
enum Stage {
  FIR_REGISTERED
  UNDER_INVESTIGATION
  CHARGE_SHEET_FILED
  IN_COURT
  CLOSED_JUDGMENT
}

// D-07: fixed verdict list recorded when a case closes (IN_COURT -> CLOSED_JUDGMENT).
enum Verdict {
  CONVICTED
  ACQUITTED
  DISCHARGED
  COMPOUNDED
}

// D-14/D-15/D-16/D-17: FIR fields are free text except firNumber, which is
// manually typed by the officer and must be DB-unique.
model Case {
  id              String    @id @default(uuid())
  firNumber       String    @unique
  title           String
  offenceSections String
  incidentDate    DateTime
  policeStation   String
  complainant     String
  accused         String
  description     String
  stage           Stage     @default(FIR_REGISTERED)
  verdict         Verdict?
  judgmentSummary String?
  registeredById  String
  registeredBy    User      @relation(fields: [registeredById], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stageHistory StageHistory[]
  documents    Document[]
}

// D-11: every stage move (register/advance/close/reopen) writes one row here
// in the same transaction as the mutation and the AuditLog entry.
model StageHistory {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  fromStage Stage?
  toStage   Stage
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  actorRole Role
  remark    String?
  createdAt DateTime @default(now())
}

// action stays a plain String (validated by an app-level Zod union), never a
// native Postgres enum — see RESEARCH.md Alternatives Considered: a native
// enum would require an ALTER TYPE migration every time Phase 2/3 add a new
// audit action code, conflicting with D-10's "extensible … without
// restructuring" requirement.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorId     String
  actor       User     @relation(fields: [actorId], references: [id])
  actorRole   String
  action      String
  targetType  String
  targetId    String
  targetLabel String
  details     Json?
  createdAt   DateTime @default(now())
}

// Phase 3 (D-01..D-08): fixed lists for the two kinds of files a case can
// hold. Following the "fixed list = native enum" convention already used for
// Stage/Role/Verdict (not AuditLog.action's open-string convention), since
// document/evidence categories are closed sets, unlike audit action codes.
enum DocumentKind {
  DOCUMENT
  EVIDENCE
}

enum DocumentCategory {
  FIR
  WITNESS_STATEMENT
  INVESTIGATION_RECORD
  CHARGE_SHEET
  COURT_FILING
  FORENSIC_REPORT
  LEGAL_NOTICE
  JUDGMENT
}

enum EvidenceType {
  PHOTO
  VIDEO_CCTV
  AUDIO
  FORENSIC_DATA
}

// D-05/D-08: exactly one of category/evidenceType is non-null depending on
// kind — enforced in app code (03-02), not a DB constraint.
// uploadedByRole mirrors StageHistory.actorRole's pattern of storing the
// role alongside the actor id (the "uploading department" ownership anchor).
model Document {
  id             String            @id @default(uuid())
  caseId         String
  case           Case              @relation(fields: [caseId], references: [id])
  kind           DocumentKind
  category       DocumentCategory?
  evidenceType   EvidenceType?
  title          String
  description    String?
  uploadedById   String
  uploadedBy     User              @relation(fields: [uploadedById], references: [id])
  uploadedByRole Role
  deletedAt      DateTime?
  deletedReason  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  versions DocumentVersion[]
}

// D-06: every version (document or evidence kind alike) gets a unique
// storageKey and is written via putObjectNoOverwrite — no version's bytes
// can ever be silently replaced. @@unique([documentId, versionNumber]) is
// the DOC-01/02 concurrency truth: two concurrent finalize calls for the
// same document can never both win the same version number.
model DocumentVersion {
  id                String   @id @default(uuid())
  documentId        String
  document          Document @relation(fields: [documentId], references: [id])
  versionNumber     Int
  storageKey        String   @unique
  originalFilename  String
  mimeType          String
  sizeBytes         Int
  changeNote        String?
  createdById       String
  createdBy         User     @relation(fields: [createdById], references: [id])
  createdByRole     Role
  createdAt         DateTime @default(now())

  @@unique([documentId, versionNumber])
}
